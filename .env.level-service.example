# 复制为 .env.level-service 后由服务端/部署平台填写；不要提交真实凭证。
AIHUB_AGENT_TOKEN=

# 此容器对浏览器公开的 HTTPS 根地址。它决定任务结果中的 level.json / 图片地址。
LEVEL_SERVICE_PUBLIC_ORIGIN=https://coloring-game.new.ndhy.com

# 允许调用关卡 API 的前端 origin，多个域名用英文逗号分隔。
LEVEL_SERVICE_ALLOWED_ORIGINS=https://f.new.ndhy.com

# 高细节照片预处理后会通过这个 FN 接口上传临时参考图，供 AIHub 图生图读取。
COLORVERSE_AI_REFERENCE_UPLOAD_URL=https://f.new.ndhy.com/a/coloring-game/api/ai-reference

LEVEL_SERVICE_HOST=0.0.0.0
LEVEL_SERVICE_PORT=8080
