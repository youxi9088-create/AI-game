NODE_ENV=development
PORT=4173
GENERATOR_MODE=mock
MODERATION_MODE=mock
ENABLE_INSPECTOR=true
TOKEN_RECEIPT_SECRET=development-only-change-before-production
# Real providers are intentionally unconfigured. Never expose provider keys to the browser.
OPENAI_API_KEY=
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock

# 牌友工坊静态资源统一经 AIHub 素材生产中心的 run → status → outputs。
# 不需要 Issue ID；Token 与 appId 只留在本机或部署环境，绝不传给浏览器。
AIHUB_IMAGE_SIZE=1920x2560
AIHUB_PROFILE_IMAGE_BACKGROUND=transparent

# 入场、A01–A05 等非跳舞视频统一使用 skill 的 Seedance 能力；只有首套跳舞视频使用指定跳舞工作流。
# 两条通道都通过 AIHub Agent 的 run → status → outputs。Token、工作流 ID 只在服务端环境中配置。
AIHUB_AGENT_TOKEN=
AIHUB_AGENT_BASE_URL=https://bv.new.ndhy.com/api/agent/aihub
PAL_DANCE_WORKFLOW_APP_ID=
# 自定义跳舞工作流的表单变量名与额外必填默认值由它的配置页确定。默认使用 prompt。
PAL_DANCE_PROMPT_FIELD=prompt
# 当前跳舞视频工作流强制此参考图字段；每位新牌友使用本次生成的主立绘 URL。
PAL_DANCE_REFERENCE_FIELD=image_url
PAL_DANCE_INPUTS_JSON={}

# 兼容旧 Bot API；只有 Agent Token 通道不可用时才使用，通常不需要填写。
AIHUB_DANCE_API_KEY=
AIHUB_DANCE_AUTH_SCHEME=Bearer
AIHUB_DANCE_BASE_URL=https://ai-hub-api.aiae.ndhy.com
AIHUB_DANCE_USER=dressbattle-local
AIHUB_DANCE_ENVIRONMENT=prod
PAL_DANCE_BOT_ID=
AIHUB_DANCE_PROJECT_KEY=
AIHUB_DANCE_SDP_APP_ID=

# ---- 第三方游戏模板接入（AI 游戏平台） ----
# 平台 API 基址（生产 https://ai-game.new.ndhy.com）
PARTNER_PLATFORM_BASE=https://ai-game.new.ndhy.com
# 平台发放的接入方标识与签名密钥（app_secret 只允许存在于服务端）
PARTNER_APP_ID=
PARTNER_APP_SECRET=
# 作品托管：external 外部托管（play_url）或 package 平台托管（package_url+sha256）
PARTNER_HOSTING=external
PARTNER_PLAY_URL=
PARTNER_COVER_URL=
PARTNER_ORIENTATION=landscape
PARTNER_EMBEDDABLE=true
