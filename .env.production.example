# 生产环境配置模板：复制为 .env.production.local 后填写。
# 不要把真实值提交到 Git，也不要放进 apps/web 或浏览器可访问目录。
NODE_ENV=production
PORT=4175
GENERATOR_MODE=provider
MODERATION_MODE=local-policy-gates
ENABLE_INSPECTOR=false

# AIHub 素材生产中心：角色资料卡、其他图片、Seedance 视频都使用 skill 注册能力别名。
AIHUB_AGENT_TOKEN=<填入你的 AIHUB_AGENT_TOKEN>
AIHUB_AGENT_BASE_URL=https://bv.new.ndhy.com/api/agent/aihub
AIHUB_IMAGE_SIZE=1920x2560
AIHUB_PROFILE_IMAGE_BACKGROUND=transparent

# 只有首套跳舞/换装演出视频使用指定跳舞工作流。
PAL_DANCE_WORKFLOW_APP_ID=ffc6d2e0-18b3-4909-9362-3facbb4144b5
PAL_DANCE_PROMPT_FIELD=prompt
PAL_DANCE_REFERENCE_FIELD=image_url
PAL_DANCE_INPUTS_JSON={}

# 生产环境必须替换为随机长字符串。
TOKEN_RECEIPT_SECRET=<生成一个随机的生产密钥>

# ---- 第三方游戏模板接入（AI 游戏平台） ----
PARTNER_PLATFORM_BASE=https://ai-game.new.ndhy.com
PARTNER_APP_ID=<平台发放的接入方标识>
PARTNER_APP_SECRET=<平台生成的 64 位十六进制密钥，只显示一次，仅存服务端>
PARTNER_HOSTING=external
PARTNER_PLAY_URL=<作品的可公开 HTTPS 游玩地址，须在平台白名单内>
PARTNER_COVER_URL=<封面图 HTTPS 地址，须在平台白名单内>
PARTNER_ORIENTATION=landscape
PARTNER_EMBEDDABLE=true
