NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:4173
THEME_DB_PATH=.data/theme-freecell.sqlite
THEME_ASSET_DIR=.data/theme-assets
THEME_GENERATOR_MODE=openai
ALLOW_MOCK_THEME_UI=0
ALLOW_GENERATION_FALLBACK=0
IMAGE_PROVIDER=mock
CONTENT_REVIEW_MODE=mock
SOLVER_MODE=local-heuristic
ENABLE_THEME_INSPECTOR=true
ENABLE_ANALYTICS=false
FC_SOLVE_BIN=fc-solve
# 生产环境提供真实主题服务后才填写；不要提交真实 token。
THEME_PROVIDER_URL=
THEME_PROVIDER_TOKEN=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2

# 与 hidden-object-web 相同的内部 AI 网关 + AIHub 图片流水线
# THEME_GENERATOR_MODE=aihub
# AI_GATEWAY_BASE_URL=https://ai-gateway.aiae.ndhy.com/v1
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=
# AI_GATEWAY_TIMEOUT_MS=60000
# AIHUB_AGENT_TOKEN=
# AIHUB_ASSET_SKILL_DIR=C:\Users\your-name\.agents\skills\aihub-asset-production
OPENAI_BASE_URL=https://api.openai.com/v1
THEME_PROVIDER_TIMEOUT_MS=90000
MAX_THEME_PACKAGE_MB=20

# FN 第三方游戏模板接入（只在服务端配置，禁止写入前端或仓库）
PARTNER_PLATFORM_BASE=https://ai-game.new.ndhy.com
PARTNER_APP_ID=
PARTNER_APP_SECRET=
PARTNER_TEMPLATE_IDS=
PARTNER_PUBLIC_BASE_URL=
